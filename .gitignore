# Python virtualenv
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
*$py.class

# macOS
.DS_Store

# Local editor / agent settings (not for publication)
.claude/
*.code-workspace

# Local working notes (never published)
scratchpad/

# Auto-downloaded MediaPipe Tasks bundles (re-fetched on first run)
models/mediapipe/*.task

# OpenSim runtime log (written next to wherever a model is loaded)
opensim.log

# Pipeline run outputs
runs/
*.trc
*.mot
*.sto

# Per-subject scaled models (written beside the source model by
# scale_model / run_pipeline --scale; regenerable from the clip's TRC)
*.scaled.osim

# run_so temp artifacts (reserve-augmented model / tool setup); normally
# auto-cleaned, but a killed SO run can leave them beside the model
*.so_tmp*.osim
*.so_setup.xml

# Demo material: ship the small input clip so the quick-start runs;
# ignore the regenerable derived run artifacts (annotated/merged/viz
# videos, CSVs, IK/ID outputs under demo/<clip>/).
demo/*
!demo/Wieniawski2.mp4
